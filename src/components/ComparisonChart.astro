---
import { requiredPriceNotes } from "../data/site";
---

<div class="fee-calculator" id="fee-calculator">
  <div class="fee-calculator-intro">
    <p class="section-label">MANAGEMENT FEE CALCULATOR</p>
    <h3>今の管理費と、同じ月間売上で比較</h3>
    <p>入力した条件で管理費だけを比べます。清掃費・リネンサプライ費などは物件ごとの見積もりで確認します。</p>
  </div>

  <div class="fee-calculator-grid">
    <div class="fee-calculator-fields">
      <div class="form-field">
        <label for="calc-sales">月間の宿泊売上（目安）</label>
        <div class="input-with-unit">
          <input id="calc-sales" type="number" min="0" step="1" inputmode="decimal" placeholder="例：30" />
          <span>万円</span>
        </div>
      </div>
      <div class="form-field">
        <label for="calc-plan">物件規模</label>
        <select id="calc-plan">
          <option value="5000">規模A：1R〜1LDK／約30〜45㎡</option>
          <option value="8000">規模B：2LDK／約40〜60㎡</option>
          <option value="15000">規模C：3LDK以上／60㎡以上</option>
        </select>
      </div>
      <div class="form-field">
        <label for="calc-current-fee">現在の月間管理費（分かる場合）</label>
        <div class="input-with-unit">
          <input id="calc-current-fee" type="number" min="0" step="1" inputmode="numeric" placeholder="例：60000" />
          <span>円</span>
        </div>
        <small>固定費と歩合を合わせた月額を入力。清掃費は含めないでください。</small>
      </div>
    </div>
    <div class="fee-calculator-result" aria-live="polite" aria-atomic="true">
      <p>Staybleの管理費（月額固定費 + 売上5%）</p>
      <strong id="calc-stayble-fee">売上を入力してください</strong>
      <p class="fee-calculator-breakdown" id="calc-breakdown"></p>
      <div class="fee-calculator-difference" id="calc-difference" hidden>
        <span>現在の管理費との差</span>
        <strong id="calc-difference-value"></strong>
        <small id="calc-difference-note"></small>
      </div>
      <a class="btn btn-primary" id="calc-contact-link" href="/contact/">物件条件を無料で相談する</a>
    </div>
  </div>
  <ul class="notes">
    {requiredPriceNotes.map((note) => <li>{note}</li>)}
    <li>※比較は管理費のみの概算です。売上・稼働率・最終的な手取り額を保証しません。戸建て・大型物件などは個別見積もりとなる場合があります。</li>
  </ul>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById("fee-calculator");
    if (!root) return;
    const sales = root.querySelector("#calc-sales");
    const plan = root.querySelector("#calc-plan");
    const current = root.querySelector("#calc-current-fee");
    const feeOutput = root.querySelector("#calc-stayble-fee");
    const breakdown = root.querySelector("#calc-breakdown");
    const difference = root.querySelector("#calc-difference");
    const differenceValue = root.querySelector("#calc-difference-value");
    const differenceNote = root.querySelector("#calc-difference-note");
    const contactLink = root.querySelector("#calc-contact-link");
    if (!(sales instanceof HTMLInputElement) || !(plan instanceof HTMLSelectElement) || !(current instanceof HTMLInputElement)) return;
    const yen = (value) => `${Math.round(value).toLocaleString("ja-JP")}円`;

    const update = () => {
      const hasSales = sales.value.trim() !== "";
      const salesYen = Number(sales.value) * 10000;
      const fixed = Number(plan.value);
      const valid = hasSales && Number.isFinite(salesYen) && salesYen >= 0 && salesYen <= 100000000;
      if (!valid) {
        feeOutput.textContent = "売上を入力してください";
        breakdown.textContent = "";
        difference.hidden = true;
        contactLink.href = "/contact/";
        return;
      }
      const commission = Math.round(salesYen * 0.05);
      const staybleFee = fixed + commission;
      feeOutput.textContent = yen(staybleFee);
      breakdown.textContent = `月額固定費 ${yen(fixed)} + 売上歩合 ${yen(commission)}`;
      const hasCurrent = current.value.trim() !== "";
      const currentFee = Number(current.value);
      if (hasCurrent && Number.isFinite(currentFee) && currentFee >= 0 && currentFee <= 100000000) {
        const delta = currentFee - staybleFee;
        difference.hidden = false;
        differenceValue.textContent = delta === 0 ? "同額" : yen(Math.abs(delta));
        differenceNote.textContent = delta > 0 ? "Staybleの管理費が低い概算" : delta < 0 ? "現在の管理費が低い概算" : "管理費の概算は同額です";
      } else {
        difference.hidden = true;
      }
      const params = new URLSearchParams({ monthly_sales: sales.value, plan: plan.options[plan.selectedIndex].text });
      if (hasCurrent && Number.isFinite(currentFee) && currentFee >= 0) params.set("current_fee", current.value);
      contactLink.href = `/contact/?${params.toString()}`;
    };
    [sales, current].forEach((input) => input.addEventListener("input", update));
    plan.addEventListener("change", update);
    update();
  })();
</script>
