---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = "今の管理費と比較してみませんか？",
  text = "今の管理費や清掃品質で気になることを、分かる範囲でご相談ください。詳しい住所や売上資料は後から確認します。"
} = Astro.props;
---

<section class="section cta-band">
  <div class="container cta-panel">
    <div>
      <p class="section-label">CONTACT</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn-primary" href="/contact/">今の管理費と比較する</a>
  </div>
</section>
