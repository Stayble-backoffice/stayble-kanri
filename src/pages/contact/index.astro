---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageMeta } from "../../data/site";

const meta = pageMeta.contact;
const web3formsAccessKey = "b40b2a03-d391-446f-a7d2-fdcfbfef3c3e";
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} pageName="お問い合わせ">
  <section class="page-hero contact-intro">
    <div class="container page-hero-inner contact-hero-inner">
      <p class="eyebrow">CONTACT</p>
      <h1>民泊管理会社の乗り換えを、まず相談。</h1>
      <p>今の管理費、清掃品質、OTAの切り替えなど、気になる点を分かる範囲でお知らせください。詳しい住所や売上資料は、最初の相談には不要です。</p>
    </div>
  </section>

  <section class="section contact-form-section">
    <div class="container contact-form-wrap">
      <div class="contact-assurance">
        <strong>入力は約1分</strong>
        <span>必須はお名前・メールアドレス・現在の運用状況だけです。</span>
      </div>
      <form class="form-panel contact-form-panel" id="contact-form" action="https://api.web3forms.com/submit" method="POST" aria-label="お問い合わせフォーム">
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="【乗り換え民泊管理】LPから新規問い合わせ" />
        <input type="hidden" name="from_name" value="Stayble 乗り換え民泊管理LP" />
        <input type="hidden" name="form_name" value="住宅宿泊管理 お問い合わせ" />
        <input type="hidden" name="measurement_version" value="" />
        <input type="hidden" name="first_touch_at" value="" />
        <input type="hidden" name="first_landing_page" value="" />
        <input type="hidden" name="first_landing_topic" value="" />
        <input type="hidden" name="first_referrer" value="" />
        <input type="hidden" name="traffic_source" value="" />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="utm_content" value="" />
        <input type="hidden" name="utm_term" value="" />
        <input type="hidden" name="gclid" value="" />
        <input type="hidden" name="msclkid" value="" />
        <input type="hidden" name="conversion_page" value="" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-label="この項目は入力しないでください" />

        <div class="form-grid">
          <div class="form-field">
            <label for="name">お名前 <span class="required-badge">必須</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="form-field">
            <label for="email">メールアドレス <span class="required-badge">必須</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-field">
            <label for="operation_status">現在の運用状況 <span class="required-badge">必須</span></label>
            <select id="operation_status" name="operation_status" required>
              <option value="" selected disabled>選択してください</option>
              <option value="開業済み・管理会社を利用中">開業済み・管理会社を利用中</option>
              <option value="開業済み・自主管理中">開業済み・自主管理中</option>
              <option value="開業準備中">開業準備中</option>
            </select>
          </div>
          <div class="form-field">
            <label for="city">物件の市区町村（任意）</label>
            <input id="city" name="city" type="text" autocomplete="address-level2" placeholder="例：札幌市中央区" />
          </div>
          <div class="form-field">
            <label for="phone">電話番号（任意）</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="電話での連絡を希望する場合" />
          </div>
          <div class="form-field">
            <label for="company">会社名・屋号（任意）</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="form-field">
            <label for="monthly_sales_average">月間宿泊売上の目安（任意）</label>
            <div class="input-with-unit">
              <input id="monthly_sales_average" name="monthly_sales_average" type="number" min="0" step="1" inputmode="decimal" placeholder="例：30" />
              <span>万円</span>
            </div>
          </div>
          <div class="form-field">
            <label for="current_management_fee">現在の月間管理費（任意）</label>
            <div class="input-with-unit">
              <input id="current_management_fee" name="current_management_fee" type="number" min="0" step="1" inputmode="numeric" placeholder="例：60000" />
              <span>円</span>
            </div>
          </div>
          <div class="form-field full">
            <label for="message">相談したいこと（任意）</label>
            <textarea id="message" name="message" placeholder="例：管理費が高い、清掃品質が不安、既存予約がある状態での切り替えを相談したい"></textarea>
          </div>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary" type="submit" id="contact-submit">無料相談を送信する</button>
        </div>
        <div class="form-status" id="contact-status" role="status" aria-live="polite" hidden></div>
      </form>
      <p class="contact-note">入力内容は、ご相談への回答と見積もり案内のために使用します。初回の流入元情報は送信時に限り添付されます。</p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById("contact-form");
      const submitButton = document.getElementById("contact-submit");
      const status = document.getElementById("contact-status");
      if (!(form instanceof HTMLFormElement) || !(submitButton instanceof HTMLButtonElement) || !status) return;

      const storageKey = "stayble_minpaku_first_touch_v1";
      const attributionFields = ["measurement_version", "first_touch_at", "first_landing_page", "first_landing_topic", "first_referrer", "traffic_source", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "msclkid"];
      const setFieldValue = (name, value) => {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement) input.value = String(value || "").slice(0, 200);
      };
      const populateAttribution = () => {
        setFieldValue("conversion_page", `${location.origin}${location.pathname}`);
        try {
          const stored = JSON.parse(localStorage.getItem(storageKey) || "{}");
          attributionFields.forEach((name) => setFieldValue(name, stored[name]));
        } catch { /* The form still works if storage is unavailable. */ }
      };
      const params = new URLSearchParams(location.search);
      const prefill = [
        ["monthly_sales_average", "monthly_sales"],
        ["current_management_fee", "current_fee"]
      ];
      prefill.forEach(([field, param]) => {
        const value = params.get(param);
        const input = form.elements.namedItem(field);
        if (input instanceof HTMLInputElement && value && /^\d{1,9}$/.test(value)) input.value = value;
      });
      const plan = params.get("plan");
      if (plan) {
        const message = form.elements.namedItem("message");
        if (message instanceof HTMLTextAreaElement) message.value = `物件規模：${plan.slice(0, 80)}。料金の比較について相談したいです。`;
      }
      populateAttribution();

      const showStatus = (kind, html) => {
        status.className = `form-status ${kind}`;
        status.innerHTML = html;
        status.hidden = false;
        status.scrollIntoView({ behavior: "smooth", block: "nearest" });
      };
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        status.hidden = true;
        if (!form.reportValidity()) return;
        populateAttribution();
        submitButton.disabled = true;
        submitButton.textContent = "送信中…";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" }
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error("Submission failed");
          if (Array.isArray(window.dataLayer)) window.dataLayer.push({ event: "generate_lead", form_name: "住宅宿泊管理 お問い合わせ" });
          if (typeof window.gtag === "function") window.gtag("event", "generate_lead", { form_name: "住宅宿泊管理 お問い合わせ" });
          form.reset();
          showStatus("success", "送信が完了しました。ご相談ありがとうございます。担当者から返信します。迷惑メールフォルダもご確認ください。");
        } catch {
          showStatus("error", '送信できませんでした。再度お試しいただくか、<a href="mailto:backoffice@windwoods-stayble.com">メールでご相談ください</a>。');
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = "無料相談を送信する";
        }
      });
    })();
  </script>
</BaseLayout>
