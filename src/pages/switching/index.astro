---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { pageMeta, switchingFlow } from "../../data/site";

const meta = pageMeta.switching;
const pains = [
  "管理費が重く、売上が伸びても管理控除後の残額が増えにくい",
  "清掃品質や報告写真が安定せず、レビュー面が不安",
  "リネンサプライ・備品・鍵・現地対応の窓口が分かれすぎている",
  "フル代行の見栄えより、現場が回る管理会社へ変えたい"
];
const freeItems = ["初期費用0円", "写真撮影0円", "OTA初期立ち上げ0円", "簡易収益シミュレーション0円"];
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path} pageName="乗り換え">
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">SWITCHING</p>
      <h1>開業済み民泊のための、管理会社乗り換え。</h1>
      <p>
        これから民泊を始める方向けではなく、すでに運用中で、管理費・清掃品質・リネンサプライ・現地対応に不満があるオーナー向けのサービスです。
      </p>
      <div class="button-row">
        <a class="btn btn-primary" href="/contact/">無料相談する</a>
        <a class="btn btn-secondary" href="/pricing/">料金を見る</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading label="ISSUES" title="こんな不満はありませんか？" />
      <div class="grid-4 desktop-card-grid">
        {pains.map((pain, index) => (
          <article class="card">
            <span class="number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{pain}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container split desktop-service-split">
      <div>
        <p class="section-label">ABOUT</p>
        <h2>乗り換え民泊管理とは</h2>
        <p>
          開業支援や申請代行を主目的にせず、運用中の民泊に必要な管理・清掃・リネンサプライ・OTA運用・現地対応を、Staybleの現場基盤で引き受けます。
        </p>
      </div>
      <div class="grid-2">
        {freeItems.map((item) => (
          <article class="card">
            <h3>{item}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        label="FLOW"
        title="乗り換えの流れ"
        lead="既存運用を確認しながら、清掃・リネンサプライ導線とOTA運用を新しく整備します。"
      />
      <div class="flow-list desktop-flow-list">
        {switchingFlow.map((step, index) => (
          <article class="card flow-card">
            <span class="number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container split desktop-service-split">
      <div>
        <p class="section-label">BEFORE SWITCHING</p>
        <h2>管理会社の切り替え前に、届出と運用の引き継ぎを確認します。</h2>
        <p>
          札幌市は、委託する住宅宿泊管理業者を変更する場合、変更後ではなくあらかじめ変更届を提出する必要があると案内しています。現在の契約、届出、OTA、鍵、清掃日程を切り分けて移行準備を進めます。
        </p>
        <p class="notes-inline">
          ※個別の手続きは物件条件により異なります。行政窓口・専門家へご確認ください。
        </p>
      </div>
      <div class="card">
        <h3>切り替え前の確認項目</h3>
        <ul class="check-list">
          <li>現管理会社との契約期間・終了日</li>
          <li>住宅宿泊事業の届出内容・変更時期</li>
          <li>OTA予約・ゲスト対応の引き継ぎ範囲</li>
          <li>鍵・清掃・リネンサプライの切替日</li>
        </ul>
        <a
          class="text-link"
          href="https://www.city.sapporo.jp/keizai/kanko/minpaku/20190409after.html"
          target="_blank"
          rel="noopener noreferrer"
        >札幌市「民泊の届出・運営について」を確認する</a>
      </div>
    </div>
  </section>

  <section class="section feature-band">
    <div class="container split desktop-service-split">
      <div>
        <p class="section-label">OTA SETUP</p>
        <h2>OTA運用はStayble側で新しく整備します。</h2>
      </div>
      <div class="card">
        <p>
          原則として既存OTAアカウントの引き継ぎは行いません。Stayble側で新しく運用環境を立ち上げ、オーナー様には補助ホストとして必要な確認に参加いただきます。
        </p>
        <ul class="check-list">
          <li>OTA掲載内容の作成・整備</li>
          <li>Stayble標準撮影写真の反映</li>
          <li>メッセージ対応・レビュー返信</li>
          <li>簡易的な価格調整・カレンダー調整</li>
        </ul>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
