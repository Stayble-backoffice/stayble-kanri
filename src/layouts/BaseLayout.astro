---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AttributionTracker from "../components/AttributionTracker.astro";
import { LAST_UPDATED, SITE_URL, areas, siteMeta } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  pageName?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  preloadImage?: string;
}

const { title, description, path, pageName, schema, preloadImage } = Astro.props;
const canonical = new URL(path, SITE_URL).toString();
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "LocalBusiness"],
    "@id": `${SITE_URL}#organization`,
    name: "株式会社Stayble",
    legalName: "株式会社Stayble",
    url: SITE_URL,
    logo: `${SITE_URL}images/stayble-logo-cropped.webp`,
    image: siteMeta.ogImage,
    identifier: {
      "@type": "PropertyValue",
      propertyID: "法人番号",
      value: "5430001094167"
    },
    address: {
      "@type": "PostalAddress",
      postalCode: "064-0805",
      addressRegion: "北海道",
      addressLocality: "札幌市中央区",
      streetAddress: "南五条西15丁目2-3-503",
      addressCountry: "JP"
    },
    areaServed: areas,
    sameAs: ["https://windwoods-stayble.com/", "https://www.stayble.jp/"]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}#website`,
    url: SITE_URL,
    name: siteMeta.name,
    alternateName: ["Stayble 民泊管理", "乗り換え民泊管理"],
    inLanguage: "ja-JP",
    publisher: {
      "@id": `${SITE_URL}#organization`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${SITE_URL}#service`,
    name: "乗り換え民泊管理",
    url: SITE_URL,
    provider: {
      "@type": "Organization",
      "@id": `${SITE_URL}#organization`,
      name: "株式会社Stayble"
    },
    areaServed: areas,
    audience: {
      "@type": "BusinessAudience",
      audienceType: "開業済み民泊オーナー"
    },
    description:
      "国土交通大臣登録の住宅宿泊管理業者として、既存管理会社からの乗り換えを検討する開業済み民泊オーナー向けに、清掃・リネンサプライ・OTA運用・現地対応を提供します。",
    serviceType: "住宅宿泊管理、開業済み民泊向け乗り換え管理、民泊清掃管理、OTA運用支援"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: "ja-JP",
    dateModified: LAST_UPDATED,
    isPartOf: {
      "@id": `${SITE_URL}#website`
    },
    about: {
      "@id": `${SITE_URL}#service`
    },
    publisher: {
      "@id": `${SITE_URL}#organization`
    }
  },
  ...(path === "/"
    ? []
    : [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: [
            {
              "@type": "ListItem",
              position: 1,
              name: "トップ",
              item: SITE_URL
            },
            {
              "@type": "ListItem",
              position: 2,
              name: pageName ?? title,
              item: canonical
            }
          ]
        }
      ]),
  ...(Array.isArray(schema) ? schema : schema ? [schema] : [])
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="株式会社Stayble" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM向けサイト概要" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}
    <meta name="theme-color" content="#0b2a52" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteMeta.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteMeta.ogImageAlt} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteMeta.ogImage} />
    <meta name="twitter:image:alt" content={siteMeta.ogImageAlt} />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AttributionTracker />
  </body>
</html>
